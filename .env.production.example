# ⚠️ PRODUCTION ENVIRONMENT VARIABLES ⚠️
# Copy this file to .env and fill with your production values
# NEVER commit .env to git!

# PostgreSQL Configuration
# REQUIRED: Must be set for production
POSTGRES_USER=tradejourney
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=tradejourney
POSTGRES_EXTERNAL_PORT=5433

# Version de l'application
APP_VERSION="prod_w_1.1.0"

# Application Configuration
# REQUIRED: Must be set for production
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# admin token (local only)
ADMIN_API_TOKEN=CHANGE_ME_TO_RANDOM_SECRET

# Node environment (required for production build)
NODE_ENV=production

# Optional: Application port (default: 3001)
EXTERNAL_PORT=3001

# Optional: Debug mode (default: false in production)
DEBUG_MODE=false

# Quantower API Configuration
QUANTOWER_ENABLE=true

# Optional: Polygon API key for market data
POLYGON_API_KEY=

# Optional: Show log view button (default: false in production)
SHOW_LOG_VIEW=false

# Plugins enabled (default: false in production)
PLUGINS_ENABLED=false

# Storage server (requires tradeJourney-private-tools submodule)
STORAGE_SERVER_PORT=5000
STORAGE_SERVER_DEBUG=false
CLEANUP_DAYS_OLD=2

# ============================================
# SECURITY CHECKLIST FOR PRODUCTION:
# ============================================
# ✅ Change POSTGRES_PASSWORD to a strong password (20+ chars)
# ✅ Change JWT_SECRET to a random string (use: openssl rand -base64 32)
# ✅ Set DEBUG_MODE=false
# ✅ Don't expose POSTGRES_EXTERNAL_PORT publicly (use firewall)
# ✅ Use HTTPS with a reverse proxy (nginx, Caddy, Traefik)
# ✅ Setup automated backups
# ✅ Keep this .env file secure (chmod 600)
