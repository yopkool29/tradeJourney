# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432
POSTGRES_USER=tradejourney
POSTGRES_PASSWORD=postgresPassword1234
POSTGRES_DB=tradejourney

# PostgreSQL URLs (for development - hardcoded values since Prisma doesn't expand ${VAR})
POSTGRES_URL_AUTH=postgresql://tradejourney:postgresPassword1234@localhost:5432/tradejourney?schema=public
POSTGRES_URL_TEMPLATE=postgresql://tradejourney:postgresPassword1234@localhost:5432/tradejourney

# Version de l'application
APP_VERSION="dev_w_1.1.0"

# Optional: Debug mode (default: false in production)
DEBUG_MODE=true

# NinjaTrader API Configuration
NINJATRADER_API_ENABLE=true

# Quantower API Configuration
QUANTOWER_ENABLE=true

# Clé secrète JWT (IMPORTANT: à changer en production)
# Générer avec: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# admin token (local only)
ADMIN_API_TOKEN=CHANGE_ME_TO_RANDOM_SECRET

# Port externe de l'application (production)
EXTERNAL_PORT=3000

# Clé API Polygon (optionnel, pour les données de marché)
POLYGON_API_KEY=""