# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433
POSTGRES_USER=pnltracker
POSTGRES_PASSWORD=postgresPassword1234
POSTGRES_DB=pnltracker

# PostgreSQL URLs (for development - hardcoded values since Prisma doesn't expand ${VAR})
POSTGRES_URL_AUTH=postgresql://pnltracker:postgresPassword1234@localhost:5433/pnltracker?schema=public
POSTGRES_URL_TEMPLATE=postgresql://pnltracker:postgresPassword1234@localhost:5433/pnltracker

# Version de l'application
APP_VERSION="dev_w_1.1.0"

# Optional: Debug mode (default: false in production)
DEBUG_MODE=true

# Optional: Show log view button (default: true in dev, false in production)
SHOW_LOG_VIEW=true

# Quantower API Configuration
QUANTOWER_ENABLE=true

# Clé secrète JWT (IMPORTANT: à changer en production)
# Générer avec: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# admin token (local only)
ADMIN_API_TOKEN=CHANGE_ME_TO_RANDOM_SECRET

# MCP local (PNLTRACKER_MCP_TOKEN must match the user's API token)
PNLTRACKER_API_URL=http://127.0.0.1:3001
PNLTRACKER_MCP_TOKEN=CHANGE_ME_TO_USER_API_TOKEN

# Port externe de l'application (production)
EXTERNAL_PORT=3000

# Plugins enabled (default: false in production)
PLUGINS_ENABLED=false

# Dev plugins: comma-separated list of plugin IDs to load from plugins-dev/_release/
# Plugins are auto-activated and served from the build output (no import needed)
# Example: DEV_PLUGINS=schwab-converter,tradingview-converter
DEV_PLUGINS=

# Test user for integration tests
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword
