{
  "build": {
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splashscreen",
        "title": "PnlTracker",
        "url": "loading.html",
        "width": 400,
        "height": 250,
        "resizable": false,
        "fullscreen": false,
        "visible": true,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true
      },
      {
        "label": "main",
        "title": "PnlTracker",
        "url": "loading.html",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "resources": [
      "runtime"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "desktop-template.desktop"
      }
    }
  }
}
