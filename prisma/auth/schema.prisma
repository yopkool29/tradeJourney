// Schema for Authentication Database
// Contains user accounts and database references

generator client {
    provider               = "prisma-client-js"
    output                 = "../../generated/prisma-auth"
    binaryTargets          = ["native", "linux-musl-openssl-3.0.x"]
    engineType             = "library"
}

datasource db {
    provider = "postgresql"
    url      = env("POSTGRES_URL_AUTH")
}

model User {
    id        Int        @id @default(autoincrement())
    email     String     @unique
    password  String
    token     String    @unique // Token pour l'authentification API
    settings  String     @default("{}")
    metadata  Json?    @db.JsonB
    databases Database[]
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
}

model Database {
    id               Int      @id @default(autoincrement())
    userId           Int
    user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    name             String // Technical name/slug (ex: "trading_2024")
    displayName      String // Display name (ex: "Trading 2024")
    schemaName       String   @unique // PostgreSQL schema name (ex: "user_1_db_trading_2024")
    isDefault        Boolean  @default(false)
    migrationVersion Int      @default(0) // Current migration version applied to this schema
    metadata         Json?    @db.JsonB
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    @@unique([userId, name])
    @@index([userId])
    @@index([schemaName])
}
