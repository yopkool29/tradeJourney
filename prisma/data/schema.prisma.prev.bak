// Schema for Data Database
// Contains all trading data (trades, tags, accounts, etc.)

generator client {
    provider               = "prisma-client-js"
    output                 = "../../generated/prisma-data"
    binaryTargets          = ["native", "linux-musl-openssl-3.0.x"]
    engineType             = "library"
}

datasource db {
    provider = "postgresql"
    url      = env("POSTGRES_URL_TEMPLATE")
}

model Trade {
    id            Int          @id @default(autoincrement())
    uniqueId      String       @unique
    active        Boolean
    openDate      DateTime
    closeDate     DateTime
    symbol        String
    type          String // 'buy' ou 'sell'
    lot           Float
    openPrice     Float
    closePrice    Float
    stopLoss      Float?       @default(0)
    takeProfit    Float?       @default(0)
    profit        Float        // Profit BRUT (avant déduction des commissions)
    netProfit     Float        // Profit NET (après déduction des commissions)
    profit_points Float
    commission    Float?       @default(0)
    exchange      Float?       @default(0)
    instrumentType String      @default("any") // stock, future, forex, call, put, any
    mae           Float?       // Maximum Adverse Excursion
    mfe           Float?       // Maximum Favorable Excursion
    strikePrice   Float?       // Options: prix d'exercice
    expirationDate DateTime?   // Options: date d'expiration
    optionType    String?      // Options: 'call' ou 'put'
    premium       Float?       // Options: prime payée/reçue
    metadata      Json?        @db.JsonB // Données flexibles (dates originales, greeks, etc.)
    note          String?
    screenshotUrl String? // Garder pour compatibilité
    screenshots   Screenshot[] // Nouvelle relation pour plusieurs images (optionnel par défaut)
    accountId     Int
    account       Account      @relation(fields: [accountId], references: [id])
    importName    String?      // Source de l'import (MT5, NT8, Quantower, etc.)
    createdAt     DateTime     @default(now())
    updatedAt     DateTime     @updatedAt

    tags TradeTagAssociation[]
}

model Screenshot {
    id        Int      @id @default(autoincrement())
    url       String
    tradeId   Int
    trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
    metadata  Json?    @db.JsonB
    createdAt DateTime @default(now())
    @@index([tradeId])
}

model TagGroup {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    tags      Tag[]
    metadata  Json?    @db.JsonB
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Tag {
    id                Int                   @id @default(autoincrement())
    name              String
    description       String?
    color             String? // Optionnel, pour l'affichage
    dark_fg_reverse   Boolean @default(false) // Pour l'affichage en mode sombre
    groupId           Int
    group             TagGroup              @relation(fields: [groupId], references: [id])
    tradeTags         TradeTagAssociation[]
    metadata          Json?    @db.JsonB
    createdAt         DateTime              @default(now())
    updatedAt         DateTime              @updatedAt
    dayTags           DayTag[]              @relation("DayTagsOnTags")
    DayTagAssociation       DayTagAssociation[]
    importProfileDayTags    ImportProfileDayTag[]
    importProfileTradeTags  ImportProfileTradeTag[]

    @@unique([name, groupId])
}

model DayTag {
    id                Int                 @id @default(autoincrement())
    date              DateTime // ou startDate et endDate pour une plage
    note              String?
    tags              Tag[]               @relation("DayTagsOnTags")
    metadata          Json?    @db.JsonB
    createdAt         DateTime            @default(now())
    updatedAt         DateTime            @updatedAt
    DayTagAssociation DayTagAssociation[]
}

model TradeTagAssociation {
    tradeId Int
    tag     Tag @relation(fields: [tagId], references: [id])

    tagId Int
    trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

    @@unique([tradeId, tagId])
    @@map("TradeTag")
}

// Table de jointure pour la relation many-to-many entre DayTag et Tag
model DayTagAssociation {
    dayTagId Int
    dayTag   DayTag @relation(fields: [dayTagId], references: [id], onDelete: Cascade)

    tagId Int
    tag   Tag @relation(fields: [tagId], references: [id])

    @@id([dayTagId, tagId])
}

model Account {
    id            Int      @id @default(autoincrement())
    name          String   @unique
    fullname      String
    displayName   String   @default("abcdef")
    aliases       String   @default("")
    trades        Trade[]
    metadata      Json?    @db.JsonB
    createdAt     DateTime @default(now())
}

model ConfigSymbol {
    id            Int      @id @default(autoincrement())
    symbol        String   @unique
    digit         Int      @default(2) // nombre de décimales à afficher pour ce symbole
    active        Boolean  @default(true)
    notes         String?
    aliases       String   @default("")
    pricePerPoint Float    @default(-1)
    metadata      Json?    @db.JsonB
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
}

model ImportProfile {
    id                  Int      @id @default(autoincrement())
    name                String   @unique
    provider            String   // mt5, nt8, nt8-api, quantower, ibkr, ibkr-api, standard
    importMode          String   @default("local") // local ou utc
    timezone            String   @default("Europe/Paris")
    keepExistingTrades  Boolean  @default(false)
    dayTags             ImportProfileDayTag[]
    tradeTags           ImportProfileTradeTag[]
    instrumentType      String   @default("any") // any, forex, future, stock, crypto, call, put
    ibkrFlexQueryToken  String?
    ibkrFlexQueryId     String?
    metadata            Json?    @db.JsonB // Données flexibles (filtres symboles, etc.)
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt
}

model ImportProfileDayTag {
    importProfileId Int
    importProfile   ImportProfile @relation(fields: [importProfileId], references: [id], onDelete: Cascade)
    tagId           Int
    tag             Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@id([importProfileId, tagId])
}

model ImportProfileTradeTag {
    importProfileId Int
    importProfile   ImportProfile @relation(fields: [importProfileId], references: [id], onDelete: Cascade)
    tagId           Int
    tag             Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@id([importProfileId, tagId])
}

model DailyNote {
    id        Int      @id @default(autoincrement())
    date      DateTime @unique // Date unique pour chaque note
    content   String   // Contenu riche de la note
    metadata  Json?    @db.JsonB
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([date])
}

model Plugin {
    id          String   @id // ex: "trade-stats-plugin"
    name        String
    version     String
    description String
    metadata    Json?    @db.JsonB
    enabled     Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}
