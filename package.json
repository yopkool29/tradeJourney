{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:safe": "nuxt prepare && nuxt dev",
    "debug": "nuxi dev --inspect",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node server-start.mjs",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "lint": "eslint \"**/*.{js,ts,vue}\" --ignore-pattern \"temp/**\" --rule '@typescript-eslint/no-unused-vars: off'",
    "build:plugin": "PLUGIN=$npm_config_plugin npx vite build --config plugins-dev/vite.config.plugin.ts",
    "count": "find . -type f \\( -name \"*.vue\" -o -name \"*.ts\" -o -name \"*.js\" -o -name \"*.prisma\" -o -name \"*.py\" \\) -not -path \"*/node_modules/*\" -not -path \"*/generated/*\" -not -path \"*/.nuxt/*\" -not -path \"*/.output/*\" -not -path \"*/.vscode/*\" -not -path \"*/temp/*\" -not -path \"*/.venv/*\" | xargs wc -l",
    "migrate:images": "npx tsx scripts/migrate-image-urls.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.52",
    "@internationalized/date": "^3.11.0",
    "@milkdown/core": "^7.20.0",
    "@milkdown/crepe": "^7.20.0",
    "@milkdown/plugin-prism": "^7.20.0",
    "@milkdown/plugin-slash": "^7.20.0",
    "@milkdown/plugin-upload": "^7.20.0",
    "@milkdown/preset-commonmark": "^7.20.0",
    "@milkdown/preset-gfm": "^7.20.0",
    "@milkdown/theme-nord": "^7.20.0",
    "@milkdown/vue": "^7.20.0",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "1.13.0",
    "@nuxt/image": "1.10.0",
    "@nuxt/scripts": "0.11.7",
    "@nuxt/ui": "^3.2.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "^9.5.6",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.1",
    "@prisma/client": "^6.10.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/archiver": "^6.0.3",
    "@unhead/vue": "^2.0.11",
    "@vueuse/integrations": "^14.3.0",
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "chardet": "^2.1.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-crosshair": "^2.0.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "eslint": "^9.29.0",
    "execa": "^9.6.1",
    "extract-zip": "^2.0.1",
    "formidable": "^3.5.4",
    "jsonwebtoken": "^9.0.2",
    "lightweight-charts": "^5.0.9",
    "luxon": "^3.6.1",
    "nuxt": "^3.17.5",
    "nuxt-zod-i18n": "^1.12.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.3.0",
    "sortablejs": "^1.15.7",
    "tsx": "4.21.0",
    "typescript": "^5.8.3",
    "vue": "^3.5.17",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.1",
    "vue3-apexcharts": "^1.11.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.67"
  },
  "packageManager": "pnpm@10.12.4",
  "devDependencies": {
    "@nuxt/test-utils": "^3.19.1",
    "@types/adm-zip": "^0.5.8",
    "@types/dotenv": "^8.2.3",
    "@types/formidable": "^3.4.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "happy-dom": "^20.8.9",
    "mcp-remote": "^0.1.17",
    "node-html-parser": "^7.0.1",
    "nuxi": "^3.25.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.1",
    "prisma": "^6.10.1",
    "sass": "^1.89.2",
    "tailwindcss": "^4.1.11",
    "ufo": "^1.6.1",
    "vite": "^8.0.8",
    "vitest": "^3.2.4"
  }
}
